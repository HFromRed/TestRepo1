    kind: 2
    region: 0
    enemy: {fileID: 0}
    background: {fileID: 21300000, guid: 6a59a8fd190613c44813b264e6a0d486, type: 3}
    credits: 20
    choices:
    - label: "\u8BB0\u4F4F\u65CB\u5F8B / \u83B7\u5F97 Noise Charge\uFF0C\u4E0B\u4E00\u6218\u521D\u59CB\u566A\u58F0 +15\uFF0C\u8BB0\u5FC6 +1"
      consequence: "\u4F60\u8BB0\u4F4F\u4E86\u65CB\u5F8B\u3002\u5B83\u6CA1\u6709\u7528\u9014\uFF0C\u4F46\u5B83\u5C5E\u4E8E\u4F60\u3002"
      heal: 0
